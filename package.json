{
  "name": "hamptons-home-management",
  "version": "1.0.0",
  "description": "Hamptons Home Management Website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "analyze": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation\" next experimental-analyze",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:email": "dotenvx run -- email dev --dir=./src/components/app/email --port=3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint",
    "format": "oxfmt",
    "type-check": "tsc --noEmit --incremental",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation next start",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/payload-cloud": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "date-fns": "4.4.0",
    "focus-trap-react": "12.0.3",
    "libphonenumber-js": "1.13.14",
    "lodash-es": "4.18.1",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "next-recaptcha-v3": "1.5.3",
    "payload": "3.90.2",
    "payload-totp": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use": "17.6.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.31.1",
    "@react-email/ui": "6.11.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/gtag.js": "0.0.20",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "react-email": "6.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide"
    ]
  }
}
